{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "phosphene: install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "phosphene: open",
      "type": "shell",
      "windows": {
        "command": "cmd",
        "args": ["/c", "Start Phosphene.bat"]
      },
      "osx": {
        "command": "bash",
        "args": ["Start Phosphene.command"]
      },
      "linux": {
        "command": "bash",
        "args": ["Start Phosphene.command"]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "phosphene: serve",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "dependsOn": ["phosphene: install"],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|ready in)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
