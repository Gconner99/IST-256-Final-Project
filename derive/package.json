{
  "name": "derive",
  "version": "0.1.0",
  "private": true,
  "description": "Dérive — a psychogeographic still-image instrument inspired by the Situationist International.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
